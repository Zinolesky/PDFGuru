# Optional: Google Gemini API Key for Vision PDF Q->A auto-detection (flat & scanned PDFs)
# and AI-powered unstructured text parsing. Without a key, DocuFill AI still works fully
# offline using AcroForm extraction, vector geometry Q->A detection, and deterministic parsing.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides (defaults to gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Optional: comma-separated CORS origins for production hosting
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: protect /api/* endpoints with a bearer/X-API-Key token when hosting publicly
# DOCUFILL_ACCESS_TOKEN=

# Optional: folder of local blank PDFs to auto-seed on startup
# SEED_PDFS_DIR=
